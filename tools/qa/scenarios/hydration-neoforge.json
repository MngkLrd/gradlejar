{
  "schema": 1,
  "name": "Hydration 0.2.0 server model and source regression",
  "coverage": [
    {
      "id": "water-balance",
      "kind": "mechanic",
      "subject": "Water loss, heat, humidity, activity, boundaries",
      "checks": [
        {
          "backend": "server",
          "name": "Model rules"
        }
      ]
    },
    {
      "id": "source-classification",
      "kind": "mechanic",
      "subject": "Actual source versus nonwater",
      "checks": [
        {
          "backend": "server",
          "name": "Fresh pond classification"
        },
        {
          "backend": "server",
          "name": "Solid is not water"
        }
      ]
    },
    {
      "id": "absorption",
      "kind": "mechanic",
      "subject": "Gradual absorption and bounded reserve",
      "checks": [
        {
          "backend": "server",
          "name": "Model rules"
        }
      ]
    },
    {
      "id": "physiology",
      "kind": "mechanic",
      "subject": "Body temperature replaces environmental heat, active bleeding adds bounded loss",
      "checks": [
        {
          "backend": "server",
          "name": "Model rules"
        }
      ]
    },
    {
      "id": "water-transfer-model",
      "kind": "mechanic",
      "subject": "Capacity and volume/salt/risk conservation; conservative quality",
      "checks": [
        {
          "backend": "server",
          "name": "Model rules"
        }
      ]
    }
  ],
  "steps": [
    {
      "name": "Model rules",
      "command": "hydration selftest",
      "expect": "HYDRATION_MODEL_CHECKS_PASSED",
      "assertion": true
    },
    {
      "command": "forceload add 0 0",
      "expect": "force loaded"
    },
    {
      "command": "setblock 3 200 3 minecraft:stone",
      "expect": "Changed the block"
    },
    {
      "command": "setblock 3 201 3 minecraft:water",
      "expect": "Changed the block"
    },
    {
      "name": "Fresh pond classification",
      "command": "hydration inspect 3 201 3",
      "expect": "source=(POND|RIVER|LAKE|SPRING) quality=DRINKABLE",
      "assertion": true
    },
    {
      "name": "Solid is not water",
      "command": "hydration inspect 3 200 3",
      "expect": "source=NONE quality=NOT_WATER",
      "assertion": true
    }
  ]
}
