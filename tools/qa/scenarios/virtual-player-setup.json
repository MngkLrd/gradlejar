{
  "schema": 1,
  "name": "Network-player sandbox preflight only",
  "steps": [
    {
      "command": "forceload add 0 0",
      "expect": "force loaded"
    },
    {
      "wait": 2
    },
    {
      "command": "setblock 1 198 1 minecraft:stone",
      "expect": "Changed the block"
    },
    {
      "command": "execute if block 1 198 1 minecraft:stone",
      "expect": "Test passed",
      "assertion": true,
      "name": "Sandbox world available; not a mod gameplay result"
    }
  ]
}
