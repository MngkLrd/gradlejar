{
  "multipart": [
    {
      "apply": {
        "model": "primitivewater:block/gutter_core"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "primitivewater:block/gutter_arm"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "primitivewater:block/gutter_arm",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "primitivewater:block/gutter_arm",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "primitivewater:block/gutter_arm",
        "y": 270
      }
    }
  ]
}