{
  "multipart": [
    {
      "apply": {
        "model": "primitivewaterworks:block/wooden_downspout_white_cedar"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "primitivewaterworks:block/downspout_north_white_cedar"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "primitivewaterworks:block/downspout_south_white_cedar"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "primitivewaterworks:block/downspout_east_white_cedar"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "primitivewaterworks:block/downspout_west_white_cedar"
      }
    },
    {
      "when": {
        "wet": "true"
      },
      "apply": {
        "model": "primitivewaterworks:block/downspout_water"
      }
    }
  ]
}
