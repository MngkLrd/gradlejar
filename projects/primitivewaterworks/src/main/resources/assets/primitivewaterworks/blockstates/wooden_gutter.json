{
  "multipart": [
    {
      "apply": {
        "model": "primitivewaterworks:block/gutter_core"
      }
    },
    {
      "when": {
        "OR": [
          {
            "north": "true"
          },
          {
            "axis": "z"
          }
        ]
      },
      "apply": {
        "model": "primitivewaterworks:block/gutter_north"
      }
    },
    {
      "when": {
        "OR": [
          {
            "south": "true"
          },
          {
            "axis": "z"
          }
        ]
      },
      "apply": {
        "model": "primitivewaterworks:block/gutter_south"
      }
    },
    {
      "when": {
        "OR": [
          {
            "east": "true"
          },
          {
            "axis": "x"
          }
        ]
      },
      "apply": {
        "model": "primitivewaterworks:block/gutter_east"
      }
    },
    {
      "when": {
        "OR": [
          {
            "west": "true"
          },
          {
            "axis": "x"
          }
        ]
      },
      "apply": {
        "model": "primitivewaterworks:block/gutter_west"
      }
    },
    {
      "when": {
        "drop": "true"
      },
      "apply": {
        "model": "primitivewaterworks:block/gutter_drop"
      }
    }
  ]
}
