{
  "multipart": [
    {
      "apply": {
        "model": "primitivewaterworks:block/wooden_downspout_mangrove"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "primitivewaterworks:block/downspout_north_mangrove"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "primitivewaterworks:block/downspout_south_mangrove"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "primitivewaterworks:block/downspout_east_mangrove"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "primitivewaterworks:block/downspout_west_mangrove"
      }
    },
    {
      "when": {
        "wet": "true"
      },
      "apply": {
        "model": "primitivewaterworks:block/downspout_water"
      }
    }
  ]
}
