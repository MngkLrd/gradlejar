{
  "multipart": [
    {
      "apply": {
        "model": "primitivewaterworks:block/wooden_downspout_afc_cypress"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "primitivewaterworks:block/downspout_north_afc_cypress"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "primitivewaterworks:block/downspout_south_afc_cypress"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "primitivewaterworks:block/downspout_east_afc_cypress"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "primitivewaterworks:block/downspout_west_afc_cypress"
      }
    },
    {
      "when": {
        "wet": "true"
      },
      "apply": {
        "model": "primitivewaterworks:block/downspout_water"
      }
    }
  ]
}
