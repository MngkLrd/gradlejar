{
  "multipart": [
    {
      "apply": {
        "model": "primitivewaterworks:block/wooden_downspout"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "primitivewaterworks:block/downspout_north"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "primitivewaterworks:block/downspout_south"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "primitivewaterworks:block/downspout_east"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "primitivewaterworks:block/downspout_west"
      }
    },
    {
      "when": {
        "wet": "true"
      },
      "apply": {
        "model": "primitivewaterworks:block/downspout_water"
      }
    }
  ]
}
