{
  "multipart": [
    {
      "apply": {
        "model": "primitivewaterworks:block/collector_frame_pine"
      }
    },
    {
      "when": {
        "north": "false"
      },
      "apply": {
        "model": "primitivewaterworks:block/collector_wall_closed_pine",
        "y": 0
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "primitivewaterworks:block/collector_wall_open_pine",
        "y": 0
      }
    },
    {
      "when": {
        "east": "false"
      },
      "apply": {
        "model": "primitivewaterworks:block/collector_wall_closed_pine",
        "y": 90
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "primitivewaterworks:block/collector_wall_open_pine",
        "y": 90
      }
    },
    {
      "when": {
        "south": "false"
      },
      "apply": {
        "model": "primitivewaterworks:block/collector_wall_closed_pine",
        "y": 180
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "primitivewaterworks:block/collector_wall_open_pine",
        "y": 180
      }
    },
    {
      "when": {
        "west": "false"
      },
      "apply": {
        "model": "primitivewaterworks:block/collector_wall_closed_pine",
        "y": 270
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "primitivewaterworks:block/collector_wall_open_pine",
        "y": 270
      }
    },
    {
      "when": {
        "water_level": "1"
      },
      "apply": {
        "model": "primitivewaterworks:block/collector_water_1"
      }
    },
    {
      "when": {
        "water_level": "2"
      },
      "apply": {
        "model": "primitivewaterworks:block/collector_water_2"
      }
    },
    {
      "when": {
        "water_level": "3"
      },
      "apply": {
        "model": "primitivewaterworks:block/collector_water_3"
      }
    },
    {
      "when": {
        "water_level": "4"
      },
      "apply": {
        "model": "primitivewaterworks:block/collector_water_4"
      }
    },
    {
      "when": {
        "bottom": "false"
      },
      "apply": {
        "model": "primitivewaterworks:block/collector_bottom_closed_pine"
      }
    },
    {
      "when": {
        "bottom": "true"
      },
      "apply": {
        "model": "primitivewaterworks:block/collector_bottom_open_pine"
      }
    }
  ]
}
